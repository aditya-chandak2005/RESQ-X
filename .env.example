# ==============================================================================
# RESQ-X Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="RESQ-X AI Disaster Response Intelligence Platform"
API_V1_STR="/api"

# Database Configuration (PostgreSQL + PostGIS or SQLite fallback for development)
# For local Docker/PostgreSQL: postgresql://postgres:postgres@localhost:5432/resqx
# For portable lightweight dev: sqlite:///./resqx.db
DATABASE_URL=sqlite:///./resqx.db

# CORS Allowed Origins (Comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# AI / Model Configurations
AI_MODEL_PATH="./ml/models/flood_seg_v1.onnx"
AI_INFERENCE_DEVICE="cpu"
AI_CONFIDENCE_THRESHOLD=0.65

# External Satellite & Map API Keys (Optional - Demo mode works offline)
COPICUS_API_KEY=""
SENTINEL_HUB_CLIENT_ID=""
SENTINEL_HUB_CLIENT_SECRET=""
OPENWEATHER_API_KEY=""

# AI Copilot LLM Configuration (Optional - Built-in rule & knowledge engine works offline)
GEMINI_API_KEY=""

# Routing Configuration
DEFAULT_BASE_LAT=30.0869
DEFAULT_BASE_LON=78.2676
DEFAULT_SEARCH_RADIUS_KM=50.0
