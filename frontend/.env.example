# ==============================================================================
# RESQ-X Frontend Environment Configuration
# ==============================================================================

# Backend API endpoint (defaults to http://127.0.0.1:8001 if omitted)
VITE_API_URL="http://127.0.0.1:8001"

# CARTO Basemap API Key
# Sign up and obtain a free API key at: https://carto.com/basemaps/apikey/
# Required for unwatermarked CARTO Voyager tiles on the Geographic basemap.
# When omitted, RESQ-X displays a diagnostic HUD banner and permits 1-click fallback to Google Satellite.
VITE_CARTO_API_KEY=""

# Optional Custom Basemap Tile URLs
# VITE_MAP_GEOGRAPHIC_URL="https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png"
# VITE_MAP_SATELLITE_URL="https://mt{s}.google.com/vt/lyrs=y&hl=en&x={x}&y={y}&z={z}"
# VITE_MAP_TERRAIN_URL="https://server.arcgisonline.com/ArcGIS/rest/services/World_Topo_Map/MapServer/tile/{z}/{y}/{x}"
# VITE_MAP_DARK_URL="https://services.arcgisonline.com/arcgis/rest/services/Canvas/World_Dark_Gray_Base/MapServer/tile/{z}/{x}/{y}"
